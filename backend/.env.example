# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/retailpulse_ai

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS (comma-separated list of allowed origins; leave blank to allow all in dev)
CORS_ORIGIN=http://localhost:5173

# Mock commerce webhook (Phase 2) — shared secret the simulated provider must send
# via the X-Webhook-Secret header. Not a real credential; safe to leave at its default
# for local development. See docs/API.md for details.
MOCK_COMMERCE_WEBHOOK_SECRET=local-dev-mock-webhook-secret

# Python FastAPI ML service (Phase 3) — internal only, never exposed to the frontend.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=15000

# Optional periodic prediction/anomaly run (SHOULD HAVE, off by default).
# Never runs under NODE_ENV=test regardless of this flag.
ENABLE_PREDICTION_CRON=false
PREDICTION_CRON_SCHEDULE=0 3 * * *
