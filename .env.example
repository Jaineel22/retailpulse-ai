# Root-level env file for `docker compose up` — copy to `.env` and fill in
# real values. This file is separate from backend/.env.example,
# ml-service/.env.example, and frontend/.env.example, which remain the source
# of truth for running each service directly (without Docker).

# MongoDB reachable from inside the containers. For a MongoDB running on this
# same host machine: use host.docker.internal (works on Docker Desktop and,
# via the extra_hosts entry in docker-compose.yml, on Linux too). For MongoDB
# Atlas: use your Atlas connection string directly.
MONGODB_URI=mongodb://host.docker.internal:27017/retailpulse_ai

# JWT — generate a real random string, never use a placeholder in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Must match wherever the frontend container is actually served from.
CORS_ORIGIN=http://localhost:5173

# Frontend build arg — baked into the JS bundle at build time (see
# frontend/Dockerfile). Point this at the backend's externally-reachable URL.
VITE_API_URL=http://localhost:5000/api

# Not a real credential — protects only the local/demo mock-commerce webhook endpoint.
MOCK_COMMERCE_WEBHOOK_SECRET=local-dev-mock-webhook-secret

# Gemini LLM provider — leave blank to run with the AI assistant gracefully
# disabled (POST /api/ai/ask returns 503; every other endpoint is unaffected).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional periodic prediction/anomaly run — off by default.
ENABLE_PREDICTION_CRON=false
