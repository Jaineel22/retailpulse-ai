# Same database the Node backend uses — the ML service reads inventoryevents
# from it directly. There is no second database.
MONGODB_URI=mongodb://127.0.0.1:27017/retailpulse_ai

# Internal service only — do not bind to 0.0.0.0 / expose publicly.
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000

# Minimum days of sale history required before forecasting/anomaly detection
# will run at all (below this: a controlled INSUFFICIENT_HISTORY error).
ML_MIN_HISTORY_DAYS=21

# Days of history held out as the chronological test set for MAE/RMSE evaluation.
ML_EVAL_DAYS=14

ML_DEFAULT_HORIZON_DAYS=7
ML_MAX_HORIZON_DAYS=30
